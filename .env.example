# MedRecord AI Cloud & Offline Configuration

# Supabase Cloud Database & Auth (Replace with your project details)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Primary Cloud AI: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# High-Performance Resilient Fallback: NVIDIA NIM (Optional)
NVIDIA_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Local Air-Gapped Fallback: Ollama (Optional)
OLLAMA_BASE_URL=http://localhost:11434
